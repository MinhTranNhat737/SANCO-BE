PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
# Set this to use a separate PostgreSQL server. Omit for persistent embedded PostgreSQL.
# DATABASE_URL=postgresql://sanco:change-me@localhost:5432/sanco
# DATA_DIR=.data/postgres
# Bot worker concurrency (1-16). Default: available CPU cores minus one, capped at 4.
# BOT_WORKERS=4
# Native engines: npm run engines:install (Windows/Linux x64).
# NATIVE_ENGINES=false disables them and keeps the internal bots.
# ENGINE_PROCESSES=1
# ENGINE_HASH_MB=16
# STOCKFISH_PATH=C:/engines/stockfish.exe
# FAIRY_STOCKFISH_PATH=C:/engines/fairy-stockfish.exe
# TRUST_PROXY=1
# OAuth callbacks go through the frontend proxy (same host as the browser).
# For production, use https://sanco.games. See OAUTH-SETUP.md for local HTTPS.
PUBLIC_API_URL=http://127.0.0.1:5173
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
# Optional exact callback overrides; normally leave empty.
GOOGLE_REDIRECT_URI=
FACEBOOK_REDIRECT_URI=
